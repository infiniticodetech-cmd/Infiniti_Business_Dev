{
  "name": "WF-99 Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "1",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const execution = $input.first().json.execution;\nconst workflow = $input.first().json.workflow;\n\nreturn [{\n  json: {\n    workflow_name: workflow.name,\n    execution_id: execution.id,\n    error_message: execution.error?.message || 'Unknown error occurred in workflow',\n    error_stack: execution.error?.stack || '',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "2",
      "name": "Format Error Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SUPABASE_URL || 'http://host.docker.internal:54321' }}/rest/v1/audit_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer ={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"table_name\": \"agent_runs\",\n  \"operation\": \"ERROR_HANDLER\",\n  \"new_row\": {{ JSON.stringify($json) }}\n}",
        "options": {}
      },
      "id": "3",
      "name": "Audit Error in Database",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Format Error Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error Payload": {
      "main": [
        [
          {
            "node": "Audit Error in Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
